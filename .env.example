# ════════════════════════════════════════════════════════════
# Sellers Army CRM — muhit o'zgaruvchilari (qiymatsiz shablon)
# Nusxa oling:  cp .env.example backend/.env   (backend uchun)
# Railway/hosting'da esa Variables bo'limiga kiriting.
# ════════════════════════════════════════════════════════════

# ── MAJBURIY ─────────────────────────────────────────────────
# PostgreSQL ulanish manzili (postgresql://user:parol@host:5432/baza)
DATABASE_URL=
# JWT maxfiy kalitlar (har biri tasodifiy qator, kamida 32 belgi; bir-biridan farqli): openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Ixtiyoriy: server ────────────────────────────────────────
# Port (standart 8000)
PORT=
# Access/refresh token muddati (standart 1h / 30d)
JWT_ACCESS_TTL=
JWT_REFRESH_TTL=
# CORS ruxsat etilgan originlar, vergul bilan (bo'sh = hammasi). Monolitda shart emas
CORS_ORIGIN=
# Backendning ommaviy manzili, masalan https://crm.example.uz (webhook va forma havolalari uchun).
# Railway'da RAILWAY_PUBLIC_DOMAIN avtomatik ishlatiladi
PUBLIC_URL=

# ── Birinchi sozlash va seed (hammasi ixtiyoriy) ─────────────
# Standart: SEED_ADMIN_* BO'SH qoldiriladi. Birinchi ochilganda CRM "Birinchi sozlash" ekranini ko'rsatadi
# va egasi o'z admin login/parolini o'zi yaratadi. Faqat ikkalasi (EMAIL va PASSWORD) berilsa `npm run db:seed`
# super adminni oldindan yaratadi (parol kamida 8 belgi).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
# Ochiq (internetdagi) yangi o'rnatishni himoyalash: berilsa, "Birinchi sozlash" ekranida shu kodni kiritish shart
# (aks holda manzilni birinchi topgan odam admin bo'lib olishi mumkin). Masalan: openssl rand -hex 16
SETUP_TOKEN=

# ── OnlinePBX telefoniya (ixtiyoriy) ─────────────────────────
# Barchasini CRM ichidagi Sozlamalar -> Telefoniya (OnlinePBX) oynasidan ham kiritish mumkin;
# UI'da saqlangan qiymat env'dan ustun turadi.
# PBX domeni, masalan pbx12345.onpbx.ru
ONLINEPBX_DOMAIN=
# OnlinePBX API kaliti (auth_key) — maxfiy
ONLINEPBX_KEY=
# Operator ichki raqami topilmasa ishlatiladigan standart (masalan 101)
ONLINEPBX_DEFAULT_EXT=
# Webhook himoyasi: onlinepbx webhook URL oxiriga ?secret=<shu qiymat> qo'yiladi
ONLINEPBX_WEBHOOK_SECRET=
# callback (OnlinePBX o'zi operatorni jiringlatadi) | softphone
ONLINEPBX_CALL_MODE=
# softphone rejimida: tel | sip | callto
ONLINEPBX_DIAL_SCHEME=
# API bazaviy manzili (standart https://api.onlinepbx.ru)
ONLINEPBX_BASE=

# ── Telegram bildirishnoma / suhbat (ixtiyoriy) ──────────────
# @BotFather bergan bot tokeni. Webhook: https://<PUBLIC_URL>/api/v1/telegram/webhook
TELEGRAM_BOT_TOKEN=
# Webhook himoyasi (ixtiyoriy, tavsiya etiladi): tasodifiy qator; Telegram uni X-Telegram-Bot-Api-Secret-Token sarlavhasida yuboradi
TELEGRAM_WEBHOOK_SECRET=

# ── Facebook Lead Ads (ixtiyoriy) ────────────────────────────
# Meta ilovasi (developers.facebook.com). Webhook: https://<PUBLIC_URL>/api/v1/facebook/webhook
FB_APP_ID=
FB_APP_SECRET=
# Webhook tasdiqlash uchun o'zingiz o'ylab topgan qator (Meta'dagi Verify Token bilan bir xil)
FB_VERIFY_TOKEN=

# ── FRONTEND (frontend/.env — faqat dev/build vaqtida) ───────
# API bazaviy yo'li (standart /api/v1)
VITE_API_BASE=
# true bo'lsa backend'siz mock ma'lumotlar bilan ishlaydi (faqat demo)
VITE_USE_MOCKS=
# Dev rejimida vite proxy nishoni (standart http://localhost:8000)
VITE_API_URL=
