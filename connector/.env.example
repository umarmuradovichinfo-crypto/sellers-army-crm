# ── Meta Connector (vendor, BIR MARTA deploy) ───────────────
# Meta ilovasi (developers.facebook.com) kalitlari
FB_APP_ID=
FB_APP_SECRET=
# Connector'ning ommaviy HTTPS manzili (Meta'dagi yagona Redirect URI: <shu>/fb/callback, Webhook: <shu>/fb/webhook)
CONNECTOR_PUBLIC_URL=https://connector.sizning-domen.uz
# SQLite fayl yo'li (Railway'da /data Volume ulang, aks holda deploy'da ma'lumot yo'qoladi)
DATABASE_PATH=/data/connector.db
# Sahifa tokenlari va instance sirlarini shifrlash kaliti (AES-256-GCM). Uzun tasodifiy qator: openssl rand -hex 32
TOKEN_ENC_KEY=
# Ixtiyoriy
PORT=8100
# leadgen (standart). Keyinroq: leadgen,messages
FB_SUBSCRIBED_FIELDS=leadgen
FB_GRAPH_VERSION=v26.0
# Faqat dev: http instance manzillariga ruxsat (production'da QO'YMANG)
ALLOW_INSECURE=
