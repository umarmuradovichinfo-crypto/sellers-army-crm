// Sellers Army CRM backend — Prisma 7 (cjs klient, NestJS uchun)
// Datasource url: prisma.config.ts (DATABASE_URL)

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id       String  @id @default(cuid())
  key      String  @unique // 'super_admin', 'sotuvchi', 'traffic'
  name     String // ko'rinadigan nom
  isSystem Boolean @default(false)
  rightsJson String? // amoCRM «Права доступа» matritsasi (common/rights/rights.ts)

  permissions RolePermission[]
  users       User[]

  createdAt DateTime @default(now())
}

model Permission {
  id  String @id @default(cuid())
  key String @unique // 'dashboard.view', 'crm.view', 'settings.roles.manage' ...

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  avatar       String?
  isActive     Boolean    @default(true)
  extension    String? // OnlinePBX ichki raqami (click-to-call shu raqamdan)
  sipPassword  String? // OnlinePBX SIP paroli (brauzer WebRTC-telefoni registratsiyasi uchun)
  phone        String? // amoCRM «Настройки профиля» → Телефон
  note         String? // «Примечание»
  groupId      String? // amoCRM «Группа» (otdel) — huquq profili (role) dan alohida
  group        UserGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([groupId])
}

// amoCRM «Пользователи → Настройка групп»: foydalanuvchilar guruhlari (otdellar)
model UserGroup {
  id        String   @id @default(cuid())
  name      String
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  users     User[]

  @@map("crm_user_groups")
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String // refresh token hash (rotatsiya)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  // amoCRM «Сеансы»: bitta refresh token = bitta sessiya (qurilma)
  ip         String?
  ua         String?
  lastUsedAt DateTime?

  @@index([userId])
}

// ─────────────────────────────────────────────
// CRM — sotuv voronkasi (amoCRM uslubi)
// ─────────────────────────────────────────────
model CrmPipeline {
  id        String   @id @default(cuid())
  name      String
  order     Int      @default(0)
  isDefault Boolean  @default(false)
  archived  Boolean  @default(false) // amoCRM "Архивные воронки"
  createdAt DateTime @default(now())

  @@map("crm_pipelines")
}

model CrmStage {
  id         String   @id @default(cuid())
  key        String   @unique
  name       String
  color      String   @default("#3F77DD")
  kind       String   @default("open") // open | won | lost
  order      Int      @default(0)
  isSystem   Boolean  @default(false)
  pipelineId String? // qaysi voronka (null = standart)
  hintsJson  String   @default("{}") // bosqich tavsiflari {novice, experienced, master}
  createdAt  DateTime @default(now())

  @@index([order])
  @@index([pipelineId])
  @@map("crm_stages")
}

model Lead {
  id             String    @id @default(cuid())
  name           String
  phone          String?
  email          String?
  company        String?
  companyId      String? // bog'langan Company entitisi
  contactId      String? // asosiy Contact
  source         String? // Instagram | Meta Ads | Telegram | Tavsiya | Sayt ...
  value          Int       @default(0) // byudjet (so'm)
  pipelineId     String? // qaysi voronka (null = standart)
  stage          String    @default("new") // CrmStage.key
  queue          Int       @default(0)
  assigneeId     String? // mas'ul sotuvchi
  tagsJson       String    @default("[]")
  customJson     String    @default("{}") // maxsus maydonlar qiymatlari
  itemsJson      String    @default("[]") // mahsulot pozitsiyalari [{productId,name,price,qty}]
  unsorted       Boolean   @default(false) // saralanmagan (formadan kelgan, qabul qilinmagan)
  formId         String? // qaysi lead-capture formadan keldi
  hot            Boolean   @default(false)
  nextTask       String? // keyingi qadam (matn)
  nextTaskDate   DateTime?
  notesJson      String    @default("[]") // [{text, at, by}]
  telegramChatId String? // Telegram suhbat ID (2 tomonlama yozishuv uchun)
  lostReason     String? // yo'qotish sababi (lost bosqichda)
  wonAt          DateTime? // sotuv yopilgan payt
  lostAt         DateTime? // yo'qotilgan payt
  lastActivityAt DateTime? // oxirgi faoliyat
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  // Qidiruv ustunlari — DB trigger (leads_norm_trg) phone/email'dan avtomatik to'ldiradi, kodda yozilmaydi
  phoneDigits    String? // telefon faqat raqamlar
  phoneTail      String? // telefonning oxirgi 9 raqami (dublikat qidiruvi)
  emailNorm      String? // lower(trim(email))

  tasks        LeadTask[]
  contactLinks LeadContact[]

  @@index([stage])
  @@index([pipelineId])
  @@index([assigneeId])
  @@index([companyId])
  @@index([contactId])
  @@index([phoneTail])
  @@index([emailNorm])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([value])
  @@index([name])
  @@index([pipelineId, stage, queue])
  @@map("leads")
}

// OnlinePBX qo'ng'iroqlar jurnali (CRM telefoniya integratsiyasi)
model CallLog {
  id          String   @id @default(cuid())
  leadId      String? // mos kelgan lid (telefon bo'yicha topiladi)
  userId      String? // operator (ichki raqam egasi)
  phone       String // mijoz raqami
  direction   String   @default("out") // in | out
  status      String   @default("ringing") // ringing | answered | completed | missed | failed
  durationSec Int      @default(0) // umumiy davomiylik (jiringlash + suhbat)
  talkSec     Int      @default(0) // suhbat (gaplashish) davomiyligi
  hangup      String? // uzilish sababi (provayderdan)
  rating      Int? // mijoz bahosi 1..5 («Оценка качества»)
  recordUrl   String? // audio yozuv havolasi
  externalId  String?  @unique // provayder qo'ng'iroq uuid (OnlinePBX uuid / Asterisk CRM_UUID yoki UniqueID); NULL lar cheklanmaydi
  handled     Boolean  @default(false) // kiruvchi oyna ko'rsatildimi
  startedAt   DateTime @default(now())

  @@index([leadId])
  @@index([direction, status])
  @@index([startedAt])
  @@index([phone])
  @@map("call_logs")
}

// Sayt «Callback» vidjeti so'rovlari — sutkalik cheklovlar (raqam/kalit bo'yicha) bazada hisoblanadi (bir nechta nusxada ham to'g'ri).
model CallbackRequest {
  id        String   @id @default(cuid())
  phoneKey  String // oxirgi 9 raqam
  ip        String?
  createdAt DateTime @default(now())

  @@index([phoneKey, createdAt])
  @@index([createdAt])
  @@map("callback_requests")
}

// Lid vazifalari (zadacha) — amoCRM uslubi. Sotuvchi asosan shular bilan ishlaydi.
model LeadTask {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title       String
  type        String    @default("task") // call | meeting | message | task
  dueDate     DateTime?
  done        Boolean   @default(false)
  doneAt      DateTime?
  result      String? // bajarilish natijasi (amoCRM kabi)
  assigneeId  String?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([leadId])
  @@index([done])
  @@index([dueDate])
  @@index([leadId, done, dueDate])
  @@map("lead_tasks")
}

// Maxsus maydonlar (lead/contact/company uchun)
model CrmField {
  id                 String   @id @default(cuid())
  entity             String   @default("lead") // lead | contact | company
  key                String // slug (customJson kaliti)
  label              String
  type               String   @default("text") // text|textarea|number|select|multiselect|date|url|checkbox|phone|email
  optionsJson        String   @default("[]") // select/multiselect variantlari
  required           Boolean  @default(false)
  order              Int      @default(0)
  active             Boolean  @default(true)
  groupName          String   @default("") // amoCRM uslubidagi maydon guruhi (bo'lim nomi)
  requiredStagesJson String   @default("[]") // amoCRM "Обязательно": shu bosqichlarga o'tishda to'ldirilishi shart (bosqich kalitlari)
  createdAt          DateTime @default(now())

  @@unique([entity, key])
  @@index([entity])
  @@map("crm_fields")
}

// Avtomatlashtirish (Digital Pipeline) — trigger (event + kechikish + jadval) + shartlar + amallar
model Automation {
  id             String    @id @default(cuid())
  name           String
  pipelineId     String?
  trigger        String    @default("stage_enter") // lead_created | stage_enter | created_or_enter | assignee_changed | conversation_created | message_in | no_reply_hours | call_in | before_date_field | exact_time | daily
  stageKey       String? // bosqich (null = "Saralanmagan" ustuni — voronka bo'yicha)
  conditionsJson String    @default("[]") // [{field, value|from|to}]
  actionsJson    String    @default("[]") // [{type, ...params}]
  delay          Int       @default(0) // kechikish (daqiqa)
  scheduleJson   String    @default("{}") // vaqt triggerlari: {hours, field} | {at} | {time} ; no_reply_hours: {hours}
  lastRunAt      DateTime? // exact_time / daily oxirgi bajarilishi
  active         Boolean   @default(true)
  order          Int       @default(0)
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  jobs AutomationJob[]

  @@index([trigger])
  @@map("crm_automations")
}

// Kechiktirilgan / vaqt bo'yicha bajariladigan avtomatlashtirish navbati (cron tick har daqiqa)
model AutomationJob {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  leadId       String
  runAt        DateTime
  status       String     @default("pending") // pending | done | failed | skipped
  depth        Int        @default(0) // zanjir chuqurligi (cheksiz sikldan himoya)
  dedupeKey    String? // takroriy ishga tushishni oldini olish (no_reply, before_date_field)
  error        String?
  createdAt    DateTime   @default(now())
  doneAt       DateTime?

  @@unique([automationId, dedupeKey])
  @@index([status, runAt])
  @@index([leadId])
  @@map("crm_automation_jobs")
}

// Faoliyat tarixi (timeline + audit log)
model Activity {
  id        String   @id @default(cuid())
  leadId    String?
  type      String // created|updated|stage|note|task_created|task_done|call|field|won|lost|assignee|tag|automation|email
  actorId   String?
  actorName String?
  text      String?
  dataJson  String   @default("{}")
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([createdAt])
  @@map("crm_activities")
}

// Yo'qotish sabablari
model LostReason {
  id        String   @id @default(cuid())
  name      String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("crm_lost_reasons")
}

// Teglar katalogi (rang + takliflar)
model CrmTag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#3F77DD")
  createdAt DateTime @default(now())

  @@map("crm_tags")
}

// In-app bildirishnomalar
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("info") // info | task | lead | mention | automation
  text      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

// Saqlangan filtrlar (foydalanuvchi ko'rinishlari)
model SavedFilter {
  id         String   @id @default(cuid())
  userId     String
  name       String
  paramsJson String   @default("{}")
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("crm_saved_filters")
}

// Kompaniya entitisi
model Company {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  email       String?
  website     String?
  customJson  String   @default("{}")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  phoneDigits String? // trigger to'ldiradi: asosiy + qo'shimcha telefonlar raqamlari (probel bilan)
  assigneeKey String? // trigger to'ldiradi: customJson._assigneeId, bo'lmasa createdById (mas'ul bo'yicha filtr/saralash)

  @@index([name])
  @@index([createdAt])
  @@index([assigneeKey])
  @@map("crm_companies")
}

// Kontakt entitisi
model Contact {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  email       String?
  position    String?
  companyId   String?
  customJson  String   @default("{}")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  phoneDigits String? // trigger to'ldiradi: asosiy + qo'shimcha telefonlar raqamlari (probel bilan)
  assigneeKey String? // trigger to'ldiradi: customJson._assigneeId, bo'lmasa createdById (mas'ul bo'yicha filtr/saralash)

  leadLinks LeadContact[]

  @@index([companyId])
  @@index([name])
  @@index([createdAt])
  @@index([assigneeKey])
  @@map("crm_contacts")
}

// Lead-capture web forma (ommaviy havola orqali to'ldiriladi -> lid yaratadi)
// ─────────────────────────────────────────────
// Facebook Lead Ads integratsiyasi (amoCRM logikasi)
// ─────────────────────────────────────────────
model FbLeadForm {
  id           String   @id @default(cuid())
  formId       String   @unique // Facebook leadgen form id
  formName     String
  pageId       String
  pageName     String   @default("")
  destination  String   @default("crm") // crm | hr
  pipelineId   String? // CRM: qaysi voronka
  stageKey     String? // CRM: boshlang'ich bosqich
  assigneeId   String? // CRM: avto mas'ul
  position     String? // HR: lavozim
  source       String   @default("Facebook")
  active       Boolean  @default(true)
  fieldMapJson String   @default("{}") // FB maydon -> lead maydoni
  createdAt    DateTime @default(now())

  @@map("fb_lead_forms")
}

model FbProcessedLead {
  id        String   @id @default(cuid())
  leadgenId String   @unique // FB leadgen_id — takroriy webhookni oldini oladi
  formId    String?
  createdAt DateTime @default(now())

  @@map("fb_processed_leads")
}

model CrmForm {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  description  String?
  fieldsJson   String   @default("[]") // [{key,label,type,required,options,...}]
  settingsJson String   @default("{}") // {themeColor, confirmationMessage, progressBar}
  pipelineId   String?
  stageKey     String? // yangi lid qaysi bosqichga tushadi
  assigneeId   String? // avto mas'ul
  source       String? // manba belgisi (masalan "Sayt formasi")
  active       Boolean  @default(true)
  submissions  Int      @default(0)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("crm_forms")
}

// Suhbat xabarlari (omnichannel — hozircha Telegram). Lid kartochkasida ko'rinadi.
model Message {
  id         String   @id @default(cuid())
  leadId     String
  channel    String   @default("telegram") // telegram | whatsapp | instagram ...
  direction  String   @default("in") // in | out
  text       String
  senderName String?
  externalId String? // kanal xabar id
  threadId   String? // kanal suhbat/mijoz id (Messenger PSID, Instagram IGSID) — lidni topish va javob uchun
  pageId     String? // qaysi Facebook sahifa orqali (javob yuborish uchun)
  kind       String   @default("message") // message | comment (Instagram/Facebook izoh)
  status     String   @default("sent") // sent | delivered | read | error (amoCRM: «Доставлено», «Прочитано», «Ошибка»)
  convNo     Int? // qaysi suhbatga tegishli (ConversationState.number)
  error      String?
  createdAt  DateTime @default(now())

  @@index([leadId])
  @@index([createdAt])
  @@index([channel, threadId])
  @@map("crm_messages")
}

// imBox suhbat holati (amoCRM: «Закрыть» beseda, «Избранные»). Yangi kiruvchi xabar suhbatni qayta ochadi.
model ConversationState {
  leadId     String    @id
  closed     Boolean   @default(false)
  closedAt   DateTime?
  closedById String?
  favJson    String    @default("[]") // sevimlilarga qo'shgan foydalanuvchilar
  number     Int       @default(dbgenerated("nextval('crm_conv_number_seq'::regclass)")) // amoCRM «Беседа № A…»
  updatedAt  DateTime  @updatedAt

  @@map("crm_conversations")
}

// amoCRM Salesbot: konstruktor sxemasi (qadamlar grafi) va triggerlar
model Salesbot {
  id           String   @id @default(cuid())
  name         String
  active       Boolean  @default(true)
  stepsJson    String   @default("[]") // [{id, type, x, y, ...sozlamalar, next / buttons[].next / branches}]
  startId      String? // «Запуск бота»dan keyingi birinchi qadam
  triggersJson String   @default("[]") // [{type: stage_enter|lead_created|message_in, pipelineId?, stageKey?}]
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("crm_salesbots")
}

// Bot ishga tushishi (bitim bo'yicha): javob kutish, pauza, natija
model SalesbotRun {
  id        String    @id @default(cuid())
  botId     String
  leadId    String
  stepId    String? // joriy (kutilayotgan) qadam
  state     String    @default("running") // running | waiting | paused | done | stopped | error
  varsJson  String    @default("{}") // oxirgi javob va h.k.
  resumeAt  DateTime?
  error     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([leadId, state])
  @@index([botId])
  @@index([state, resumeAt])
  @@map("crm_salesbot_runs")
}

// Sotuv rejasi / maqsadlar (oylik, hodim yoki jamoa bo'yicha)
model SalesGoal {
  id        String   @id @default(cuid())
  userId    String? // null = butun jamoa
  period    String // YYYY-MM
  metric    String   @default("revenue") // revenue | count
  target    Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, period, metric])
  @@index([period])
  @@map("crm_sales_goals")
}

// Umumiy ilova sozlamalari (key-value)
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// Mahsulot / kurs katalogi
model Product {
  id        String   @id @default(cuid())
  name      String
  sku       String?
  price     Int      @default(0)
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("crm_products")
}

// Bitimning qo'shimcha kontaktlari (amoCRM: bitimga bir nechta kontakt). Asosiy kontakt — leads.contactId.
model LeadContact {
  leadId    String
  contactId String
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([leadId, contactId])
  @@index([contactId])
  @@map("crm_lead_contacts")
}

// O'chirilgan vazifalar arxivi (amoCRM vazifalar filtri → "Удаленные"): tiklanganda lead_tasks'ga qaytariladi
model DeletedTask {
  id          String    @id
  leadId      String
  title       String
  type        String    @default("task")
  dueDate     DateTime?
  done        Boolean   @default(false)
  doneAt      DateTime?
  result      String?
  assigneeId  String?
  createdById String?
  createdAt   DateTime
  deletedAt   DateTime  @default(now())
  deletedById String?

  @@index([deletedAt])
  @@map("crm_deleted_tasks")
}

// amoCRM «Сокращать ссылки»: mijozga yuborilgan havola → /api/v1/l/:code (bosilganda bitim lentasiga yozuv)
model ShortLink {
  code        String    @id
  url         String
  leadId      String?
  clicks      Int       @default(0)
  lastClickAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([leadId])
  @@map("crm_short_links")
}

// O'z telefon stansiyamiz (PLAN 45): qo'ng'iroq oqimi modullari (foydalanuvchi, raqam, vaqt qoidasi, guruh, navbat …)
model PbxModule {
  id         String   @id @default(cuid())
  type       String // user|trunk|telegram|numrule|timerule|greeting|voicemail|http|alias|postcall|group|queue
  number     String   @unique // marshrut raqami (ichki raqam, modul raqami yoki tashqi raqam)
  name       String?
  configJson String   @default("{}")
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([type])
  @@map("pbx_modules")
}

// Qora ro'yxat: shu raqamlardan kelgan qo'ng'iroqlar rad etiladi (format bo'yicha qat'iy moslik)
model PbxBlacklist {
  id        String   @id @default(cuid())
  number    String   @unique
  note      String?
  createdAt DateTime @default(now())

  @@map("pbx_blacklist")
}

// O'z telefon stansiyamiz: audio kutubxona (yuklangan fayllar; kichik hajmli, bazada saqlanadi)
model PbxAudio {
  id        String   @id @default(cuid())
  name      String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@map("pbx_audio")
}

// Avtoinformator (OnlinePBX «Автоинформатор»): ommaviy ovozli xabar kampaniyasi. Runner faqat rahbar nusxada (LeaderService).
model PbxInformer {
  id          String              @id @default(cuid())
  name        String
  audioId     String // pbx_audio.id (custom/<id>)
  status      String              @default("draft") // draft | running | paused | done
  startAt     DateTime? // shu vaqtdan oldin qo'ng'iroq qilinmaydi
  windowFrom  String              @default("09:00") // ish oynasi (Toshkent vaqti)
  windowTo    String              @default("20:00")
  maxParallel Int                 @default(2) // bir vaqtda qo'ng'iroqlar (≤10)
  retries     Int                 @default(1) // qayta urinishlar (≤3), oraliq ≥ retryMin
  retryMin    Int                 @default(30)
  dailyLimit  Int                 @default(1000) // sutkasiga ko'pi bilan qo'ng'iroq
  dayKey      String? // dayCount qaysi kun uchun (YYYY-MM-DD, Toshkent)
  dayCount    Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  targets     PbxInformerTarget[]

  @@index([status])
  @@map("pbx_informers")
}

model PbxInformerTarget {
  id         String      @id @default(cuid())
  campaignId String
  campaign   PbxInformer @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  phone      String // faqat raqamlar (998901234567)
  state      String      @default("pending") // pending | calling | answered | noanswer | failed | dnd
  attempts   Int         @default(0)
  lastAt     DateTime?
  lastResult String? // oxirgi urinish sababi (busy, noanswer, congestion, error…)
  uuid       String? // oxirgi urinishning CRM uuid'i (call_logs.externalId)
  callLogId  String?

  @@unique([campaignId, phone])
  @@index([campaignId, state])
  @@index([uuid])
  @@map("pbx_informer_targets")
}
