# Server sozlamalari (deploy/.env — repoga QO'SHILMAYDI). Sirlarni chatga yozmang.
# Asosiy domen: har mijoz <nom>.<DOMEN> da ochiladi (DNS: *.DOMEN → server IP)
DOMAIN=crm.example.uz
# Let's Encrypt xabarlari uchun email
ACME_EMAIL=admin@example.uz
# Umumiy Postgres superuser paroli (openssl rand -hex 24)
POSTGRES_PASSWORD=
# Obuna litsenziyalarini imzolash siri — barcha mijoz nusxalarida bir xil (openssl rand -hex 32)
LICENSE_SECRET=
# To'lov rekvizitlari (mijoz «Hisob va to'lov» sahifasida ko'radi)
BILLING_CARD_NUMBER=""
BILLING_CARD_HOLDER=""
BILLING_TELEGRAM=@username
# Zaxira nusxa: age (https://github.com/FiloSottile/age) OMMAVIY kaliti — maxfiy kalit serverda BO'LMASLIGI kerak
AGE_PUBLIC_KEY=
# rclone manzili (masalan b2:crm-backups yoki hetzner:crm) — `rclone config` bilan oldindan sozlanadi
RCLONE_REMOTE=
# Zaxira/yangilanish natijasi Telegramga (ixtiyoriy)
TG_BOT_TOKEN=
TG_CHAT_ID=
